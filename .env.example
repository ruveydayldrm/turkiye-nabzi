# Copy to .env and adjust. Every value is optional; defaults are shown.

# ---------- frontend (build time) ----------
# true: serve the bundled demo dataset, no backend needed (e.g. Vercel)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- backend ----------
DATABASE_URL=sqlite:///./data/nabiz.db
CORS_ORIGINS=http://localhost:3000
ENABLE_SCHEDULER=true
INGEST_INTERVAL_MINUTES=60
# When set, POST /api/ingest requires the X-Ingest-Token header
INGEST_TOKEN=

# auto: Hugging Face model if transformers is installed, otherwise the keyword lexicon
SENTIMENT_BACKEND=auto
SENTIMENT_MODEL=savasy/bert-base-turkish-sentiment-cased

# Optional LLM highlights; leave empty to disable silently
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ---------- docker compose ----------
# false skips torch/transformers for a ~10x smaller backend image (lexicon sentiment)
INSTALL_ML=true
